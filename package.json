{
  "name": "tldr-panel",
  "version": "1.1.0",
  "description": "One click. Private summary of any page, right in your side panel.",
  "private": true,
  "type": "module",
  "author": "Vin, Vin's Atelier (https://vwesley.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentwesley/tldr-panel.git"
  },
